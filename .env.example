# ====================================================================
# eero Custom Dashboard - Environment Configuration Example
# Copia questo file in .env e personalizza i valori prima dell'avvio.
# ====================================================================

# Porta host esposta sulla macchina server
HOST_PORT=8085

# Directory di archiviazione dati persistenti (SQLite & session.json)
DATA_DIR=/app/data

# Intervallo di campionamento in background dalle API eero (secondi)
POLL_INTERVAL=30

# Giorni di conservazione dello storico prima della pulizia automatica
HISTORY_RETENTION_DAYS=30

# Intervallo per lo Speed Test pianificato in background (ore, 0 per disattivare)
SPEEDTEST_INTERVAL_HOURS=12

# Modalità Demo (true per testare la dashboard con dati di rete simulati realistici)
DEMO_MODE=false

# (Opzionale) Notifiche Telegram per Nuovi Dispositivi Connessi e Alert Rete
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (Opzionale) Webhook HTTP generico (POST con JSON payload per eventi/allarmi)
WEBHOOK_URL=
