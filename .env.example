# ====================================================================
# eero Custom Dashboard - Environment Configuration Example
# Copia questo file in .env e personalizza i valori prima dell'avvio.
# ====================================================================

# Porta host esposta sulla macchina server
HOST_PORT=8085

# Directory di archiviazione dati persistenti (SQLite & session.json)
DATA_DIR=/app/data

# (Opzionale) Token permanente di sessione eero. Se impostato, non chiederà MAI il login OTP.
# Puoi copiare il valore di "user_token" generato in data/session.json
EERO_USER_TOKEN=
EERO_NETWORK_ID=

# Intervallo di campionamento in background dalle API eero (secondi)
POLL_INTERVAL=30

# Giorni di conservazione dello storico prima della pulizia automatica
HISTORY_RETENTION_DAYS=30

# Intervallo per lo Speed Test pianificato in background (ore, 0 per disattivare)
SPEEDTEST_INTERVAL_HOURS=12

# Modalità Demo (true per testare la dashboard con dati di rete simulati realistici)
DEMO_MODE=false

# (Opzionale) Notifiche Telegram per Nuovi Dispositivi Connessi e Alert Rete
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (Opzionale) Webhook HTTP generico (POST con JSON payload per eventi/allarmi)
WEBHOOK_URL=

# (Opzionale) Notifiche Discord Webhook & Pushover
DISCORD_WEBHOOK_URL=
DISCORD_ALERTS_ENABLED=false
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
PUSHOVER_ALERTS_ENABLED=false

# (Opzionale) Integrazione MQTT & Home Assistant Auto-Discovery
MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=eero_dashboard
MQTT_HA_DISCOVERY_PREFIX=homeassistant

# (Opzionale) Compattazione Dati Multi-Tier (Ore/Giorni)
RETENTION_RAW_HOURS=48
RETENTION_HOURLY_DAYS=30
RETENTION_DAILY_DAYS=365

# (Opzionale) Metadati di release & build (gestiti automaticamente dal workflow Docker CI/CD)
APP_VERSION=1.6.0
BUILD_NUMBER=1
