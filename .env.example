# ====================================================================
# eero Custom Dashboard - Environment Configuration Example
# Copy this file to .env and customize values before starting.
# ====================================================================

# Host port exposed on the server host machine
HOST_PORT=8085

# Persistent data storage directory (SQLite & session.json)
DATA_DIR=/app/data

# (Optional) Permanent eero session token. If set, OTP login is NEVER prompted.
# You can copy the "user_token" value generated in data/session.json
EERO_USER_TOKEN=
EERO_NETWORK_ID=

# Background sampling interval from eero APIs (seconds)
POLL_INTERVAL=30

# Retention days for historical data before automatic pruning
HISTORY_RETENTION_DAYS=30

# Interval for scheduled background speed tests (hours, 0 to disable)
SPEEDTEST_INTERVAL_HOURS=12

# Demo Mode (true to test the dashboard with realistic simulated network data)
DEMO_MODE=false

# (Optional) Telegram Notifications for New Connected Devices and Network Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (Optional) Timezone and daily digest dispatch hour (0-23)
TZ=Europe/Rome
DAILY_DIGEST_HOUR=21

# (Optional) Generic HTTP Webhook (POST with JSON payload for events/alerts)
WEBHOOK_URL=

# (Optional) Discord Webhook & Pushover Notifications
DISCORD_WEBHOOK_URL=
DISCORD_ALERTS_ENABLED=false
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
PUSHOVER_ALERTS_ENABLED=false

# (Optional) MQTT & Home Assistant Auto-Discovery Integration
MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=eero_dashboard
MQTT_HA_DISCOVERY_PREFIX=homeassistant

# (Optional) Multi-Tier Data Compaction (Hours/Days)
RETENTION_RAW_HOURS=48
RETENTION_HOURLY_DAYS=30
RETENTION_DAILY_DAYS=365

# (Optional) Local Administrator Credentials:
# If left empty, the Setup Wizard will appear on first web startup to configure username and password.
# If provided, they bypass the wizard and initialize the admin account immediately on first launch.
ADMIN_USER=
ADMIN_PASSWORD=

# (Optional) Release & build metadata (managed automatically by Docker CI/CD workflow)
APP_VERSION=1.6.1
BUILD_NUMBER=1
