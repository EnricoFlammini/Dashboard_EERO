{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Stato Rete eero & Gateway WAN",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "yellow", "value": 75 },
              { "color": "green", "value": 90 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "title": "Health Score",
      "type": "gauge",
      "targets": [
        { "expr": "eero_health_score", "refId": "A" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "unit": "Mbps"
        }
      },
      "gridPos": { "h": 5, "w": 5, "x": 4, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "WAN Download",
      "type": "stat",
      "targets": [
        { "expr": "eero_wan_download_mbps", "refId": "A" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "unit": "Mbps"
        }
      },
      "gridPos": { "h": 5, "w": 5, "x": 9, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "WAN Upload",
      "type": "stat",
      "targets": [
        { "expr": "eero_wan_upload_mbps", "refId": "A" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "unit": "ms"
        }
      },
      "gridPos": { "h": 5, "w": 3, "x": 14, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "title": "WAN Ping",
      "type": "stat",
      "targets": [
        { "expr": "eero_wan_ping_ms", "refId": "A" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "unit": "none"
        }
      },
      "gridPos": { "h": 5, "w": 3, "x": 17, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "title": "Client Connessi",
      "type": "stat",
      "targets": [
        { "expr": "eero_clients_total{status=\"connected\"}", "refId": "A" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "mappings": [
            { "options": { "0": { "text": "F" }, "1": { "text": "D" }, "2": { "text": "C" }, "3": { "text": "B" }, "4": { "text": "A" }, "5": { "text": "A+" } }, "type": "value" }
          ],
          "unit": "none"
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "title": "Bufferbloat Rating",
      "type": "stat",
      "targets": [
        { "expr": "eero_bufferbloat_grade_numeric", "refId": "A" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "title": "Traffico & Throughput WAN Storico",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "Mbps"
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 7 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Velocità WAN Download & Upload (Mbps)",
      "type": "timeseries",
      "targets": [
        { "expr": "eero_wan_download_mbps", "legendFormat": "Download (Mbps)", "refId": "A" },
        { "expr": "eero_wan_upload_mbps", "legendFormat": "Upload (Mbps)", "refId": "B" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 7 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "table", "placement": "right" },
        "pieType": "pie",
        "tooltip": { "mode": "single" }
      },
      "title": "Distribuzione Client per Frequenza",
      "type": "piechart",
      "targets": [
        { "expr": "eero_clients_band_total", "legendFormat": "{{band}}", "refId": "A" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102,
      "title": "Mesh Nodes & Bufferbloat Latency",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 16 },
      "id": 9,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Bufferbloat Latenza a Riposo vs Sotto Carico (ms)",
      "type": "timeseries",
      "targets": [
        { "expr": "eero_bufferbloat_latency_unloaded_ms", "legendFormat": "Unloaded (Baseline)", "refId": "A" },
        { "expr": "eero_bufferbloat_latency_download_ms", "legendFormat": "Loaded Download", "refId": "B" },
        { "expr": "eero_bufferbloat_latency_upload_ms", "legendFormat": "Loaded Upload", "refId": "C" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 16 },
      "id": 10,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "title": "Nodi Mesh Online",
      "type": "stat",
      "targets": [
        { "expr": "eero_mesh_nodes_online", "legendFormat": "Nodi Operativi", "refId": "A" },
        { "expr": "eero_mesh_nodes_total", "legendFormat": "Nodi Totali", "refId": "B" }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["eero", "network", "dashboard", "homelab", "mesh"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "eero Mesh System - Homelab Metrics",
  "uid": "eero-mesh-metrics",
  "version": 1
}
